<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>perun-spatial</groupId>
  <artifactId>perun-spatial</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>bundle</packaging>
  <name>Perun Spatial</name>
  <description>Spatial data management, geometry tools and GIS services.</description>
  
  <properties>
	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  
  	<build>
	  <resources>
		<resource>
		  <directory>${project.basedir}</directory>
		  <includes>
			<include>www/**/*.*</include>
		  </includes>
		</resource>
	  </resources>
		<plugins>
		  <plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-source-plugin</artifactId>
			<version>3.1.0</version>
			<executions>
			  <execution>
				<id>attach-sources</id>
				<goals>
				  <goal>jar</goal>
				</goals>
			  </execution>
			</executions>
		  </plugin>
		  <plugin>
			<artifactId>maven-compiler-plugin</artifactId>
			<version>3.5.1</version>
			<configuration>
			  <source>1.8</source>
			  <target>1.8</target>
			</configuration>
		  </plugin>
		  <!-- From here is the bundle configuration for the OSGI container -->
		  <plugin>
			<groupId>org.apache.felix</groupId>
			<artifactId>maven-bundle-plugin</artifactId>
			<version>4.2.0</version>
			<extensions>true</extensions>
			<configuration>
			  <instructions>
				<Bundle-SymbolicName>com.prtech.svx_spatial</Bundle-SymbolicName>
				<Bundle-Name>${project.name}</Bundle-Name>
				<Bundle-Version>${project.version}</Bundle-Version>
				<Bundle-Vendor>Perun.Tech</Bundle-Vendor>
				<Bundle-Description>${project.description}</Bundle-Description>
				<Bundle-Activator>com.prtech.svx_spatial.osgi.Activator</Bundle-Activator>
				<Export-Package>
					com.prtech.svx_spatial.geobuf.*,
					com.prtech.svx_spatial.osgi.*,
					com.prtech.svx_spatial.service.*
				</Export-Package>
				<Private-Package>!com.prtech.svx_spatial.importer.*</Private-Package>
			  </instructions>
		  	</configuration>
		  </plugin>
		</plugins>
	</build>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
